# Maintainer: Bulls64 <Bulls64@users.noreply.github.com>
#
# Recette AUR de FastVer, construite à partir de l'AppImage publiée (Python et Qt embarqués).
# Mise à jour à chaque version : tools/update_aur.sh <version> dans le dépôt FastVer.
# AUR recipe for FastVer, built from the released AppImage (Python and Qt bundled).
# Update on every release: tools/update_aur.sh <version> in the FastVer repository.

pkgname=fastver-bin
pkgver=1.4.3
pkgrel=1
pkgdesc='"About" window for Fastfetch, in the Windows 11 Winver style'
arch=('x86_64')
url='https://github.com/Bulls64/FastVer'
license=('GPL-3.0-or-later')
# Bibliothèques que l'AppImage laisse au système / libraries the AppImage leaves to the system
depends=('glibc' 'gcc-libs' 'zlib' 'zstd' 'glib2' 'fontconfig' 'freetype2' 'dbus' 'libx11' 'libxcb'
         'libglvnd' 'libdrm' 'wayland' 'hicolor-icon-theme')
optdepends=('fastfetch: system information shown by FastVer')
provides=('fastver')
conflicts=('fastver')
# Programme PyInstaller autonome : rien à retirer ni à extraire en symboles de débogage.
# Self-contained PyInstaller program: nothing to strip or split into debug symbols.
options=('!strip' '!debug')
source=("FastVer-${pkgver}-x86_64.AppImage::${url}/releases/download/v${pkgver}/FastVer-x86_64.AppImage")
noextract=("FastVer-${pkgver}-x86_64.AppImage")
sha256sums=('ab7e21ce9c99b0b89bb27837e03a4c5b96753c319699dadbc7c39e3de4381bd8')

prepare() {
  rm -rf squashfs-root
  chmod +x "FastVer-${pkgver}-x86_64.AppImage"
  "./FastVer-${pkgver}-x86_64.AppImage" --appimage-extract >/dev/null
}

package() {
  cd squashfs-root
  install -d "$pkgdir/usr/lib" "$pkgdir/usr/bin"
  cp -a usr/lib/fastver "$pkgdir/usr/lib/fastver"
  find "$pkgdir/usr/lib/fastver" -type d -exec chmod 755 {} +
  find "$pkgdir/usr/lib/fastver" -type f -exec chmod 644 {} +
  chmod 755 "$pkgdir/usr/lib/fastver/FastVer"
  ln -s ../lib/fastver/FastVer "$pkgdir/usr/bin/fastver"
  # Un nom contenant « cli » ouvre directement le mode console / a name containing “cli” opens console mode
  ln -s ../lib/fastver/FastVer "$pkgdir/usr/bin/fastver-cli"
  install -d "$pkgdir/usr/share/applications"
  sed 's/^Exec=.*/Exec=fastver/' fastver.desktop > "$pkgdir/usr/share/applications/fastver.desktop"
  install -Dm644 fastver.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/fastver.png"
}
